{
  "name": "GUARDAI",
  "description": "AI-powered phishing detection system. Analyzes URLs and website features to identify potential phishing threats using machine learning.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "frontend/popup.html",
    "default_title": "GUARD AI"
  },
  "permissions": [
    "tabs",
    "declarativeNetRequest",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:1337/*",
    "http://localhost:1337/*"
  ],
  "background": {
    "service_worker": "server_worker.js"
  },
  "content_scripts": [ {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
